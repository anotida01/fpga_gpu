session fpga_gpu_regr {
  top_dir: $ENV(REGRESSION_AREA);
  hdl_files: "$ENV(SIM_DIR)/build_dut.xrun.args $ENV(SIM_DIR)/build_dut.xrun.files $ENV(SIM_DIR)/build_tb.xrun.args $ENV(SIM_DIR)/build_tb.xrun.files $ENV(TESTS_DIR)/testcases/testcases.f";
  pre_session_script: "$ENV(SIM_DIR)/vmgr_do_build.sh";
  output_mode: terminal;
  drm: parallel_local;
  max_runs_in_parallel: 100;
}

group axfe {
  run_script: "$ENV(SIM_DIR)/vmgr_do_sim.sh";
  scan_script: "vm_scan.pl ius.flt shell.flt";
  dut_name: "axfe";             // optional label for Metrics Center reporting [2]

  test tc_axfe_basic_wr_rd {
    sim_args: "-r tb_axfe_snap +UVM_TESTNAME=tc_axfe_basic_wr_rd";
    count: 1;
    sv_seed: random;
  }
  test tc_axfe_regmap_corner {
    sim_args: "-r tb_axfe_snap +UVM_TESTNAME=tc_axfe_regmap_corner";
    count: 1;
    sv_seed: random;
  }
  test tc_axfe_start_done {
    sim_args: "-r tb_axfe_snap +UVM_TESTNAME=tc_axfe_start_done";
    count: 1;
    sv_seed: random;
  }
  test tc_axfe_start_busy {
    sim_args: "-r tb_axfe_snap +UVM_TESTNAME=tc_axfe_start_busy";
    count: 1;
    sv_seed: random;
  }
  test tc_axfe_start_dma_overlap {
    sim_args: "-r tb_axfe_snap +UVM_TESTNAME=tc_axfe_start_dma_overlap";
    count: 1;
    sv_seed: random;
  }
  test tc_axfe_dma_backpressure {
    sim_args: "-r tb_axfe_snap +UVM_TESTNAME=tc_axfe_dma_backpressure";
    count: 1;
    sv_seed: random;
  }
  test tc_axfe_dma_base_offset {
    sim_args: "-r tb_axfe_snap +UVM_TESTNAME=tc_axfe_dma_base_offset";
    count: 1;
    sv_seed: random;
  }
  test tc_axfe_dma_timeout {
    sim_args: "-r tb_axfe_snap +UVM_TESTNAME=tc_axfe_dma_timeout";
    count: 1;
    sv_seed: random;
  }
  test tc_axfe_reset_behavior {
    sim_args: "-r tb_axfe_snap +UVM_TESTNAME=tc_axfe_reset_behavior";
    count: 1;
    sv_seed: random;
  }
  test tc_axfe_intr_status_lifecycle {
    sim_args: "-r tb_axfe_snap +UVM_TESTNAME=tc_axfe_intr_status_lifecycle";
    count: 1;
    sv_seed: random;
  }
  test tc_axfe_bus_timing {
    sim_args: "-r tb_axfe_snap +UVM_TESTNAME=tc_axfe_bus_timing";
    count: 1;
    sv_seed: random;
  }
  test tc_axfe_resp_status {
    sim_args: "-r tb_axfe_snap +UVM_TESTNAME=tc_axfe_resp_status";
    count: 1;
    sv_seed: random;
  }
  test tc_axfe_wait_block_write {
    sim_args: "-r tb_axfe_snap +UVM_TESTNAME=tc_axfe_wait_block_write";
    count: 1;
    sv_seed: random;
  }
  test tc_axfe_reset_mid_write {
    sim_args: "-r tb_axfe_snap +UVM_TESTNAME=tc_axfe_reset_mid_write";
    count: 1;
    sv_seed: random;
  }
  test tc_axfe_reset_mid_read {
    sim_args: "-r tb_axfe_snap +UVM_TESTNAME=tc_axfe_reset_mid_read";
    count: 1;
    sv_seed: random;
  }
  test tc_axfe_reset_mid_dma {
    sim_args: "-r tb_axfe_snap +UVM_TESTNAME=tc_axfe_reset_mid_dma";
    count: 1;
    sv_seed: random;
  }
  test tc_axfe_reset_mid_start {
    sim_args: "-r tb_axfe_snap +UVM_TESTNAME=tc_axfe_reset_mid_start";
    count: 1;
    sv_seed: random;
  }
  test tc_axfe_wstrb_partial {
    sim_args: "-r tb_axfe_snap +UVM_TESTNAME=tc_axfe_wstrb_partial";
    count: 1;
    sv_seed: random;
  }
  test tc_axfe_prot_variety {
    sim_args: "-r tb_axfe_snap +UVM_TESTNAME=tc_axfe_prot_variety";
    count: 1;
    sv_seed: random;
  }
}

group rop {
  run_script: "$ENV(SIM_DIR)/vmgr_do_sim.sh";
  scan_script: "vm_scan.pl ius.flt shell.flt";
  dut_name: "rop";

  test tc_rop_basic {
    sim_args: "-r tb_rop_snap +UVM_TESTNAME=tc_rop_basic";
    count: 1;
    sv_seed: random;
  }
}

group gpu {
  run_script: "$ENV(SIM_DIR)/vmgr_do_sim.sh";
  scan_script: "vm_scan.pl ius.flt shell.flt";
  dut_name: "gpu";

  test tc_gpu_smoke_wr_rd {
    sim_args: "-r tb_gpu_snap +UVM_TESTNAME=tc_gpu_smoke_wr_rd";
    count: 1;
    sv_seed: random;
  }
  test tc_gpu_sys_access_basic {
    sim_args: "-r tb_gpu_snap +UVM_TESTNAME=tc_gpu_sys_access_basic +MEMH='$ENV(MEMH_DIR)/box.memh'";
    count: 1;
    sv_seed: random;
  }
  test tc_gpu_multi_frame {
    sim_args: "-r tb_gpu_snap +UVM_TESTNAME=tc_gpu_multi_frame +MEMH='$ENV(MEMH_DIR)/box.memh'";
    count: 1;
    sv_seed: random;
  }
  test tc_gpu_render_golden {
    sim_args: "-r tb_gpu_snap +UVM_TESTNAME=tc_gpu_render_golden +MEMH='$ENV(MEMH_DIR)/box.memh'";
    count: 1;
    sv_seed: random;
  }
}
